# Copier en .env (jamais commité) pour une exécution locale ou sur VPS ; sur GitHub, utiliser
# Settings -> Secrets and variables -> Actions. Toutes les clés sont facultatives.

# Génération automatique de scripts (sinon : réserve backlog/ uniquement)
ANTHROPIC_API_KEY=

# Tendances YouTube (clé API simple, lecture seule)
YOUTUBE_API_KEY=

# Voix premium (recommandé) : ElevenLabs, abonnement payant pour usage commercial
ELEVENLABS_API_KEY=

# Vraies images et vidéos (gratuit) : https://www.pexels.com/api/
PEXELS_API_KEY=

# Publication YouTube (OAuth, scope youtube.upload)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Publication TikTok (Content Posting API ; mode inbox = brouillons)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_MODE=inbox

# Publication Facebook Reels (jeton de Page)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v23.0

# dry_run | private | public
STUDIO_PUBLISH_MODE=dry_run
