# Option VPS : passage du studio déclenché par studio.timer. Installer avec deploy/install_vps.sh
[Unit]
Description=Studio IA Shorts - passage de production
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=studio
WorkingDirectory=/opt/studio
ExecStart=/opt/studio/.venv/bin/python -m studio run
ExecStartPost=/opt/studio/.venv/bin/python -m studio alerts
TimeoutStartSec=2700
Nice=10
# durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/studio
